    },
    {
      "page": "/[lang]/education",
      "regex": "^/([^/]+?)/education(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/education(?:/)?$"
    },
    {
      "page": "/[lang]/education/[slug]",
      "regex": "^/([^/]+?)/education/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/education/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[lang]/faq",
      "regex": "^/([^/]+?)/faq(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
