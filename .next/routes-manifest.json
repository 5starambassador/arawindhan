{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/[lang]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[lang]/biography",
      "regex": "^/([^/]+?)/biography(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/biography(?:/)?$"
    },
    {
      "page": "/[lang]/books",
      "regex": "^/([^/]+?)/books(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/books(?:/)?$"
    },
    {
      "page": "/[lang]/books/[slug]",
      "regex": "^/([^/]+?)/books/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/books/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[lang]/contact",
      "regex": "^/([^/]+?)/contact(?:/)?$",
