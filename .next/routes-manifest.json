    },
    {
      "page": "/[lang]/governance",
      "regex": "^/([^/]+?)/governance(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/governance(?:/)?$"
    },
    {
      "page": "/[lang]/inner-journey",
      "regex": "^/([^/]+?)/inner\\-journey(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/inner\\-journey(?:/)?$"
    },
    {
      "page": "/[lang]/institutions",
      "regex": "^/([^/]+?)/institutions(?:/)?$",
      "routeKeys": {
        "nxtPlang": "nxtPlang"
      },
      "namedRegex": "^/(?<nxtPlang>[^/]+?)/institutions(?:/)?$"
    },
    {
      "page": "/[lang]/media",
      "regex": "^/([^/]+?)/media(?:/)?$",
      "routeKeys": {
