1d:["$","div",null,{"children":[["$","h4",null,{"style":{"color":"var(--gold-glow)","fontSize":"1rem","fontWeight":800,"textTransform":"uppercase","marginBottom":"0.75rem"},"children":"முக்கிய கருப்பொருள்கள் (Key Themes):"}],["$","ul",null,{"style":{"paddingLeft":"1.25rem","display":"flex","flexDirection":"column","gap":"0.5rem","color":"var(--text-secondary)","fontSize":"0.95rem"},"children":[["$","li","0",{"children":"3C கட்டமைப்பு: மாற்றம் உருவாக்குபவர், தேர்வு செய்பவர், வாய்ப்பு உருவாக்குபவர்"}],["$","li","1",{"children":"4H ஒருங்கிணைப்பு: இதயம் (Heart), கரம் (Hand), தலை (Head), உடல் நலம் (Health)"}],["$","li","2",{"children":"பச்சாதாபம் வளர்த்தல் மற்றும் சவால்களை சுமுகமாக தீர்த்தல்"}],["$","li","3",{"children":"அழுத்தமான சூழலிலும் மன அமைதி காக்கும் விழிப்புணர்வு பயிற்சிகள்"}]]}]]}]
