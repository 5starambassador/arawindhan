5:["$","div",null,{"className":"section-py","children":["$","div",null,{"className":"container","children":[["$","div",null,{"style":{"textAlign":"center","marginBottom":"3rem","maxWidth":"800px","margin":"0 auto 3rem auto"},"children":[["$","div",null,{"style":{"marginBottom":"0.75rem"},"children":["$","span",null,{"style":{"display":"inline-block","background":"rgba(212, 175, 55, 0.1)","border":"1px solid rgba(212, 175, 55, 0.35)","color":"var(--gold-glow)","padding":"0.25rem 0.85rem","borderRadius":"9999px","fontSize":"0.8rem","fontWeight":700,"letterSpacing":"0.08em","textTransform":"uppercase"},"children":"அதிகாரப்பூர்வ வாழ்க்கை வரலாறு"}]}],["$","h2",null,{"className":"font-serif heading-gold","style":{"fontSize":"clamp(1.75rem, 3.5vw, 2.5rem)","fontWeight":700,"lineHeight":1.25,"marginBottom":"1rem"},"children":"முனைவர் ஜே. அரவிந்தன் ஜி"}],["$","p",null,{"style":{"color":"var(--text-muted)","fontSize":"1.05rem","lineHeight":1.7},"children":"நிறுவனர், முதன்மை வழிகாட்டி & நிர்வாக இயக்குனர், ஆச்சாரியா கல்வி நிறுவனம் | கல்வியியலாளர் | தொழில்முனைவோர் | ஞான குரு"}]]}],["$","div",null,{"className":"card-premium","style":{"maxWidth":"1000px","margin":"0 auto 4rem auto","padding":"2.5rem","border":"1px solid var(--border-gold)"},"children":[["$","div",null,{"style":{"display":"flex","justifyContent":"space-between","alignItems":"center","marginBottom":"1.5rem","flexWrap":"wrap","gap":"0.75rem"},"children":[["$","span",null,{"style":{"color":"var(--gold-glow)","fontSize":"0.85rem","fontWeight":800,"textTransform":"uppercase"},"children":"கல்வித் தோற்றம்: 2000 முதல் 2026"}],["$","$L18",null,{"claimId":"CLM-001","status":"CONFIRMED","language":"ta"}]]}],["$","h3",null,{"className":"font-serif heading-gold","style":{"fontSize":"1.75rem","marginBottom":"1.25rem","fontWeight":800},"children":"மெக்கானிக்கல் பொறியியலில் இருந்து மனித ஆளுமைப் புரட்சி வரை"}],["$","p",null,{"style":{"color":"var(--text-secondary)","fontSize":"1.05rem","lineHeight":1.85,"marginBottom":"1.5rem"},"children":"2000-ஆம் ஆண்டு புதுச்சேரியில் மெக்கானிக்கல் பொறியாளராக இருந்த ஒருவர், ஒரு புரட்சிகர நம்பிக்கையோடு பள்ளி ஒன்றைத் தொடங்கினார்: \"ஒவ்வொரு குழந்தையும் தனக்கென தனித்துவமான நுண்ணறிவு சாம்ராஜ்யத்தைக் கொண்டுள்ளது. பள்ளிக்கூடம் என்பது குழந்தைகளை ஒற்றை அளவுகோலில் மதிப்பிடுவதல்ல; அவர்களின் தனித்துவமான மேதமையை வெளிக்கொணர உதவுவது.\" இருபத்தைந்து ஆண்டுகளுக்குப் பிறகு, அந்த எண்ணம் 18 கல்லூரிகள், 101 பள்ளிகள், 61+ நிறுவனங்கள் மற்றும் 302+ கல்வி முன்முயற்சிகளைக் கொண்ட மாபெரும் ஆலமரமாக வளர்ந்து நிற்கிறது."}],["$","div",null,{"style":{"background":"#FFFBEB","borderLeft":"4px solid var(--gold-primary)","border":"1px solid #FDE68A","padding":"1.5rem","borderRadius":"var(--radius-sm)","marginBottom":"2rem"},"children":[["$","div",null,{"style":{"color":"var(--gold-glow)","fontWeight":800,"fontSize":"0.95rem","marginBottom":"0.5rem"},"children":"மையக் கல்விக் கோட்பாடு: திறனை விட மூளையின் செயல்பாடு"}],["$","p",null,{"style":{"color":"var(--text-secondary)","fontSize":"0.95rem","lineHeight":1.75,"fontStyle":"italic"},"children":"திறனை விட மூளையின் செயல்பாடே பிரதானம்: மதிப்பெண் என்பது நினைவுகூர்தல் மட்டுமே; மூளை செயல்பாடே உள்ளிருக்கும் எஞ்சின். அதை தசை போல பயிற்சியால் வளர்க்க முடியும். 95% பெறும் இரு குழந்தைகளில், ஒருவர் மனப்பாடம் செய்திருக்கலாம்; மற்றொருவர் சிந்திக்கும் ஆற்றலை வளர்த்திருக்கலாம். ஆச்சாரியா சிந்திக்கும் மனிதனை உருவாக்குகிறது."}]]}],["$","h4",null,{"className":"font-serif heading-white","style":{"fontSize":"1.35rem","marginBottom":"1.25rem","fontWeight":800},"children":"ஒருங்கிணைந்த மூன்று தலைமைத்துவத் தளங்கள்"}],["$","div",null,{"className":"grid-3","style":{"marginBottom":"2rem"},"children":[["$","div","0",{"style":{"background":"var(--bg-subtle)","padding":"1.25rem","borderRadius":"var(--radius-sm)","border":"1px solid var(--border-light)"},"children":[["$","div",null,{"style":{"color":"var(--gold-glow)","fontWeight":700,"fontSize":"1.05rem","marginBottom":"0.35rem"},"children":"கல்வியியலாளர்"}],["$","div",null,{"style":{"color":"var(--text-muted)","fontSize":"0.82rem","fontWeight":600,"marginBottom":"0.75rem"},"children":"ஒரு குழந்தை எவ்வாறு உண்மையாகக் கற்க வேண்டும்?"}],["$","p",null,{"style":{"color":"var(--text-secondary)","fontSize":"0.88rem","lineHeight":1.65},"children":"தசாவதானி, மைவே, மூளை செயல்பாடு கட்டமைப்பு, கியூ-மேத்ஸ், ட்ராக் தேர்வு முறை போன்ற தனியுரிமை பெற்ற கல்வி அமைப்புகளை உருவாக்கியவர்."}]]}],"$L19","$L1a"]}],"$L1b"]}],"$L1c"]}]}]
