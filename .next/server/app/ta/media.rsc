5:["$","div",null,{"className":"section-py","children":["$","div",null,{"className":"container","style":{"maxWidth":"1050px"},"children":[["$","div",null,{"style":{"textAlign":"center","marginBottom":"3rem","maxWidth":"800px","margin":"0 auto 3rem auto"},"children":[["$","div",null,{"style":{"marginBottom":"0.75rem"},"children":["$","span",null,{"style":{"display":"inline-block","background":"rgba(212, 175, 55, 0.1)","border":"1px solid rgba(212, 175, 55, 0.35)","color":"var(--gold-glow)","padding":"0.25rem 0.85rem","borderRadius":"9999px","fontSize":"0.8rem","fontWeight":700,"letterSpacing":"0.08em","textTransform":"uppercase"},"children":"சிந்தனைத் தலைமை & உரைகள்"}]}],["$","h2",null,{"className":"font-serif heading-gold","style":{"fontSize":"clamp(1.75rem, 3.5vw, 2.5rem)","fontWeight":700,"lineHeight":1.25,"marginBottom":"1rem"},"children":"கல்விச் சிந்தனைகள், மாநாட்டு உரைகள் & சர்வதேசத் தடம்"}],["$","p",null,{"style":{"color":"var(--text-muted)","fontSize":"1.05rem","lineHeight":1.7},"children":"கல்வியாளர்கள், தலைவர்கள் மற்றும் சமூகத்திற்கான முனைவர் அரவிந்தன் அவர்களின் தொலைநோக்குப் பகிர்வுகள்."}]]}],["$","div",null,{"style":{"display":"flex","flexDirection":"column","gap":"2.5rem","marginBottom":"4rem"},"children":[["$","div","MED-01",{"className":"card-premium","style":{"padding":"2.5rem"},"children":[["$","div",null,{"style":{"display":"flex","justifyContent":"space-between","alignItems":"center","marginBottom":"0.85rem","flexWrap":"wrap","gap":"0.5rem"},"children":[["$","span",null,{"style":{"background":"#FFFBEB","border":"1px solid #FDE68A","color":"var(--gold-glow)","fontWeight":800,"fontSize":"0.8rem","padding":"0.2rem 0.65rem","borderRadius":"var(--radius-sm)","textTransform":"uppercase"},"children":["கல்விச் சிந்தனை"," • ","September 2026"]}],["$","span",null,{"style":{"fontSize":"0.78rem","color":"#059669","fontWeight":700},"children":["✓ ","அதிகாரப்பூர்வ பதிவு"]}]]}],["$","h2",null,{"className":"font-serif heading-gold","style":{"fontSize":"clamp(1.5rem, 3vw, 2rem)","marginBottom":"1.25rem","lineHeight":1.3,"fontWeight":800},"children":"மனித நுண்ணறிவு + செயற்கை நுண்ணறிவு = குவாண்டம் நுண்ணறிவு"}],["$","div",null,{"style":{"color":"var(--text-secondary)","fontSize":"0.98rem","lineHeight":1.85,"whiteSpace":"pre-line","marginBottom":"1.5rem"},"children":"செயற்கை நுண்ணறிவை (AI) கண்டு பல கல்வி நிறுவனங்கள் அச்சப்படுகையில், முனைவர் அரவிந்தன் அவர்கள் ஒரு புதிய சிந்தனையை முன்வைக்கிறார்: மனித நுண்ணறிவும் செயற்கை நுண்ணறிவும் இணையும்போது குவாண்டம் நுண்ணறிவு (Quantum Intelligence) பிறக்கிறது.\n\nஆச்சாரியா சிறப்பு மேன்மை மையத்தில் பள்ளி முதல்வர்களிடையே உரையாற்றுகையில் (செப்டம்பர் 2026), அவர் 'நேரடி, ஆழமான, மற்றும் விரிந்த கற்றல் மாதிரியை' (Direct, Deep & Divergent Model) விளக்கினார்:\n• X என்பது நேரடியாகக் கற்பிக்கப்படுவது: பாடநூலும் வெளி உலகத் தகவல்களும்.\n• Y என்பது உள்ளுக்குள் புரிந்துகொள்ளப்படுவது: சுய சிந்தனை மற்றும் உள்ளுணர்வு ஒருங்கிணைப்பு.\n• Z என்பது புதிய படைப்பு: ரசகுல்லாவும் ரசமலாயும் இணைந்து புதிய சுவையை உருவாக்குவது போல, இரு சிந்தனைகள் இணைந்து புதிய தீர்வை உருவாக்குவது.\n\nகேட்டல், பேசுதல், படித்தல், எழுதுதல் ஆகியவற்றை உச்சமாகக் கருதாமல், அவற்றை தொடக்கப் படியாகக் கொண்டு பகுத்தறிவு மற்றும் விமர்சன சிந்தனையை வளர்ப்பதே உண்மையான கல்வி என்கிறார்."}]]}],["$","div","MED-02",{"className":"card-premium","style":{"padding":"2.5rem"},"children":[["$","div",null,{"style":{"display":"flex","justifyContent":"space-between","alignItems":"center","marginBottom":"0.85rem","flexWrap":"wrap","gap":"0.5rem"},"children":[["$","span",null,{"style":{"background":"#FFFBEB","border":"1px solid #FDE68A","color":"var(--gold-glow)","fontWeight":800,"fontSize":"0.8rem","padding":"0.2rem 0.65rem","borderRadius":"var(--radius-sm)","textTransform":"uppercase"},"children":["மாநாட்டு உரை"," • ","September 15–16, 2026"]}],["$","span",null,{"style":{"fontSize":"0.78rem","color":"#059669","fontWeight":700},"children":["✓ ","அதிகாரப்பூர்வ பதிவு"]}]]}],["$","h2",null,{"className":"font-serif heading-gold","style":{"fontSize":"clamp(1.5rem, 3vw, 2rem)","marginBottom":"1.25rem","lineHeight":1.3,"fontWeight":800},"children":"ஆச்சாரியாவின் வாவ் (WOW) காரணிகள்: பள்ளி முதல்வர்கள் மாநாட்டு உரை"}],"$L18"]}],"$L19"]}],"$L1a"]}]}]
