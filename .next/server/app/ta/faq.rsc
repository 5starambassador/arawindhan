இந்திய கல்வியியலாளர், தொழில்முனைவோர், எழுத்தாளர் மற்றும் ஆன்மீக வழிகாட்டி ஆவார். மெக்கானிக்கல் பொறியாளரான இவர், 2000-ஆம் ஆண்டு புதுச்சேரியில் ஆச்சாரியா கல்வி நிறுவனத்தை நிறுவினார். 25 ஆண்டுகளில் 18 கல்லூரிகள், 101 பள்ளிகள், 61+ நிறுவனங்கள் மற்றும் 302+ கல்வி முன்முயற்சிகளைக் கொண்ட மாபெரும் அமைப்பை உருவாக்கியுள்ளார்."}],["$","div",null,{"style":{"borderTop":"1px solid var(--border-light)","paddingTop":"0.85rem"},"children":["$","$L13",null,{"href":"/ta/biography","style":{"display":"inline-flex","alignItems":"center","gap":"0.4rem","color":"var(--gold-glow)","fontWeight":700,"fontSize":"0.86rem","textDecoration":"none"},"children":[["$","span",null,{"children":"மேலும் விரிவாக அறிய"}],["$","$L12",null,{"ref":"$undefined","icon":{"name":"arrow-right","size":24,"node":[["path",{"d":"M5 12h14","key":"1ays0h"}],["path",{"d":"m12 5 7 7-7 7","key":"xquz4c"}]]},"className":"$undefined","size":14}]]}]}]]}],["$","div","FAQ-02",{"className":"card-premium","style":{"padding":"2rem"},"children":[["$","div",null,{"style":{"display":"flex","justifyContent":"space-between","alignItems":"center","marginBottom":"0.75rem"},"children":[["$","span",null,{"style":{"fontSize":"0.78rem","color":"var(--gold-glow)","fontWeight":800,"textTransform":"uppercase"},"children":"Scale & Institutions"}],["$","span",null,{"style":{"fontSize":"0.78rem","color":"#059669","fontWeight":700},"children":["✓ ","சரிபார்க்கப்பட்ட பதில்"]}]]}],["$","h3",null,{"className":"font-serif heading-gold","style":{"fontSize":"1.35rem","marginBottom":"1rem","lineHeight":1.35,"fontWeight":800},"children":"ஆச்சாரியா கல்வி கட்டமைப்பில் எத்தனை பள்ளிகள் மற்றும் கல்லூரிகள் உள்ளன?"}],["$","p",null,{"style":{"color":"var(--text-secondary)","fontSize":"0.98rem","lineHeight":1.8,"marginBottom":"1.25rem"},"children":"ஆச்சாரியா கட்டமைப்பு 18 உயர்கல்விக் கல்லூரிகள் (பொறியியல், கலை & அறிவியல், ஹோட்டல் மேலாண்மை, மருத்துவம், கல்வியியல்) மற்றும் 101 பள்ளிகளை உள்ளடக்கியது. இவை சொந்தப் பள்ளிகள் (71 வளாகங்கள்), இணைக்கப்பட்ட பள்ளிகள், கூட்டு