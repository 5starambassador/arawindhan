10:T431,{"@context":"https://schema.org","@graph":[{"@type":"Person","@id":"https://arawindhan.org/#person","name":"Dr. J. Arawindhan Ji","alternateName":["Santoshi Shri. Arawindhan Ji","Dr. J. Arawindhan","முனைவர் ஜே. அரவிந்தன் ஜி"],"jobTitle":"Founder, Chief Mentor & Managing Director","worksFor":{"@type":"EducationalOrganization","name":"ACHARIYA World Class Education","url":"https://achariya.in"},"alumniOf":{"@type":"EducationalOrganization","name":"Mechanical Engineering"},"description":"Indian educationist, entrepreneur, author, and founder of ACHARIYA World Class Education (18 colleges, 101 schools, 61+ companies).","award":["Holistic Education Award (News7 Tamil Aatral Migu Asiriyar 2026)","Edu Icon Award (The Times of India)","Trendsetter Award (Times Interact)","Outstanding Youth Award in Academics & Leadership (JCI India)"],"knowsAbout":["Multiple Intelligence Theory","Dasavadani Curriculum","Whole-Brain Neuro-Development","K-12 School Architecture","Quantum Intelligence (HI + AI)","Divya Yogam & Consciousness"]}]}4:["$","html",null,{"lang":"ta","children":[["$","head",null,{"children":[["$","meta",null,{"charSet":"utf-8"}],["$","meta",null,{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","link",null,{"rel":"icon","href":"/favicon.ico"}]]}],["$","body",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],["$","$L11",null,{"lang":"ta"}],["$","main",null,{"children":["$","$L2",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]}],["$","footer",null,{"style":{"background":"#F8FAFC","borderTop":"1px solid var(--border-light)","paddingTop":"4.5rem","paddingBottom":"3rem","marginTop":"6rem"},"children":["$","div",null,{"className":"container","children":[["$","div",null,{"style":{"display":"grid","gridTemplateColumns":"repeat(auto-fit, minmax(240px, 1fr))","gap":"2.5rem","marginBottom":"3.5rem"},"children":[["$","div",null,{"children":[["$","div",null,{"className":"font-serif heading-gold","style":{"fontSize":"1.35rem","fontWeight":800,"marginBottom":"0.75rem"},"children":"முனைவர் ஜே. அரவிந்தன் ஜி"}],["$","p",null,{"style":{"color":"var(--text-muted)","fontSize":"0.92rem","lineHeight":1.7,"marginBottom":"1.25rem"},"children":"முனைவர் ஜே. அரவிந்தன் ஜி அவர்களின் கல்வி அமைப்புகள், தொழில் நிறுவனங்கள், நூல்கள் மற்றும் தத்துவங்களை ஆவணப்படுத்தும் அதிகாரப்பூர்வ அறிவுத் தளம். அனைத்து தகவல்களும் ஆவணச் சான்றுகளோடு இணைக்கப்பட்டுள்ளன."}],["$","div",null,{"style":{"display":"inline-flex","alignItems":"center","gap":"0.5rem","background":"#ECFDF5","border":"1px solid #A7F3D0","padding":"0.35rem 0.75rem","borderRadius":"var(--radius-sm)"},"children":[["$","$L12",null,{"ref":"$undefined","icon":{"name":"shield-check","size":24,"node":[["path",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z","key":"oel41y"}],["path",{"d":"m9 12 2 2 4-4","key":"dzmm74"}]]},"className":"$undefined","size":16,"color":"#059669"}],["$","span",null,{"style":{"fontSize":"0.8rem","color":"#065F46","fontWeight":700},"children":"அனைத்து சான்றுகளும் சரிபார்க்கப்பட்டன"}]]}]]}],["$","div",null,{"children":[["$","div",null,{"style":{"color":"var(--gold-glow)","fontSize":"0.92rem","fontWeight":800,"textTransform":"uppercase","letterSpacing":"0.06em","marginBottom":"1rem"},"children":"முக்கிய இணைப்புகள்"}],["$","ul",null,{"style":{"listStyle":"none","display":"flex","flexDirection":"column","gap":"0.65rem"},"children":[["$","li",null,{"children":["$","$L13",null,{"href":"/ta/biography","style":{"color":"var(--text-secondary)","textDecoration":"none","fontSize":"0.9rem","fontWeight":500},"children":"வாழ்க்கை வரலாறு & 10 அவதாரங்கள்"}]}],["$","li",null,{"children":["$","$L13",null,{"href":"/ta/education","style":{"color":"var(--text-secondary)","textDecoration":"none","fontSize":"0.9rem","fontWeight":500},"children":"தசாவதானி & 10 கல்விக் கூடங்கள்"}]}],["$","li",null,{"children":["$","$L13",null,{"href":"/ta/books","style":{"color":"var(--text-secondary)","textDecoration":"none","fontSize":"0.9rem","fontWeight":500},"children":"7 நூல்கள் & வெளியீடுகள்"}]}],"$L14"]}]]}],"$L15","$L16"]}],"$L17"]}]}]]}]]}]
18:T26f1,{"@context":"https://schema.org","@graph":[{"@type":"Person","@id":"https://arawindhan.org/#person","name":"Dr. J. Arawindhan Ji","alternateName":["Santoshi Shri. Arawindhan Ji","Dr. J. Arawindhan","முனைவர் ஜே. அரவிந்தன் ஜி"],"jobTitle":"Founder, Chief Mentor & Managing Director","worksFor":{"@type":"EducationalOrganization","name":"ACHARIYA World Class Education","url":"https://achariya.in"},"alumniOf":{"@type":"EducationalOrganization","name":"Mechanical Engineering"},"description":"Indian educationist, entrepreneur, author, and founder of ACHARIYA World Class Education (18 colleges, 101 schools, 61+ companies).","award":["Holistic Education Award (News7 Tamil Aatral Migu Asiriyar 2026)","Edu Icon Award (The Times of India)","Trendsetter Award (Times Interact)","Outstanding Youth Award in Academics & Leadership (JCI India)"],"knowsAbout":["Multiple Intelligence Theory","Dasavadani Curriculum","Whole-Brain Neuro-Development","K-12 School Architecture","Quantum Intelligence (HI + AI)","Divya Yogam & Consciousness"]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"முனைவர் ஜே. அரவிந்தன் ஜி யார்?","acceptedAnswer":{"@type":"Answer","text":"முனைவர் ஜே. அரவிந்தன் ஜி ஒரு இந்திய கல்வியியலாளர், தொழில்முனைவோர், எழுத்தாளர் மற்றும் ஆன்மீக வழிகாட்டி ஆவார். மெக்கானிக்கல் பொறியாளரான இவர், 2000-ஆம் ஆண்டு புதுச்சேரியில் ஆச்சாரியா கல்வி நிறுவனத்தை நிறுவினார். 25 ஆண்டுகளில் 18 கல்லூரிகள், 101 பள்ளிகள், 61+ நிறுவனங்கள் மற்றும் 302+ கல்வி முன்முயற்சிகளைக் கொண்ட மாபெரும் அமைப்பை உருவாக்கியுள்ளார்."}},{"@type":"Question","name":"ஆச்சாரியா கல்வி கட்டமைப்பில் எத்தனை பள்ளிகள் மற்றும் கல்லூரிகள் உள்ளன?","acceptedAnswer":{"@type":"Answer","text":"ஆச்சாரியா கட்டமைப்பு 18 உயர்கல்விக் கல்லூரிகள் (பொறியியல், கலை & அறிவியல், ஹோட்டல் மேலாண்மை, மருத்துவம், கல்வியியல்) மற்றும் 101 பள்ளிகளை உள்ளடக்கியது. இவை சொந்தப் பள்ளிகள் (71 வளாகங்கள்), இணைக்கப்பட்ட பள்ளிகள், கூட்டுப் பங்களிப்புப் பள்ளிகள் மற்றும் வழிகாட்டல் பள்ளிகள் என 4 மாதிரிகளில் இயங்குகின்றன."}},{"@type":"Question","name":"தசாவதானி பாடத்திட்டம் என்றால் என்ன?","acceptedAnswer":{"@type":"Answer","text":"தசாவதானி பாடத்திட்டம் என்பது பல்பணி அவதானக் கலையை அடிப்படையாகக் கொண்டு ஆச்சாரியாவால் உருவாக்கப்பட்ட தனித்துவமான கல்வி முறையாகும். ஹோவர்ட் கார்ட்னரின் 8 நுண்ணறிவுகளுடன், முனைவர் அரவிந்தன் உருவாக்கிய நிதி நுண்ணறிவு மற்றும் உணர்ச்சி நுண்ணறிவை இணைத்து 10 நுண்ணறிவுகளை மாணவர்களிடம் வளர்க்கிறது."}},{"@type":"Question","name":"மூளை செயல்பாடு கட்டமைப்பு (Brain Activity System) என்றால் என்ன? அது உலக சாதனைகளுடன் எவ்வாறு தொடர்புடையது?","acceptedAnswer":{"@type":"Answer","text":"மதிப்பெண்களை விட மூளையின் செயல்பாடே முக்கியம் என்ற கோட்பாட்டின்படி, நரம்பியல் திறனை வளர்க்கும் பயிற்சி முறை. சிலம்பம், மல்லக்கம்பம், யோகா, சதுரங்கம் மற்றும் பொன்னகை தியானம் ஆகிய ஐந்து கலைகளை உடற்பயிற்சியாக வழங்கி, மாணவர்களின் இரு மூளை அரைக்கோளங்களையும் தூண்டுகிறது. இதன் மூலம் மாணவர்கள் 222 கின்னஸ் மற்றும் உலக சாதனைகள் உட்பட 600+ உலக சாதனைகளை படைத்துள்ளனர்."}},{"@type":"Question","name":"ட்ராக் (TRACK) தேர்வு மாதிரி என்றால் என்ன?","acceptedAnswer":{"@type":"Answer","text":"தேர்வு பயத்தை முற்றிலும் நீக்கும் மதிப்பீட்டு முறை. இதில் செய்முறை 100% மற்றும் எழுத்துமுறை 100% சமமாக மதிப்பிடப்படுகிறது. தேர்வுக்கு முன்பே பெற்றோருக்கு குழந்தையின் கற்றல் நிலை வெளிப்படையாகத் தெரிகிறது. AI தொழில்நுட்பம் கற்றல் இடைவெளிகளை துல்லியமாக கண்டறிந்து, கூடுதல் பயிற்சிகள் மூலம் அதை நிறைவு செய்கிறது."}},{"@type":"Question","name":"முனைவர் ஜே. அரவிந்தன் ஜி எழுதிய நூல்கள் யாவை?","acceptedAnswer":{"@type":"Answer","text":"முனைவர் அரவிந்தன் ஜி ஏழு முக்கிய நூல்களை எழுதியுள்ளார்: 1. தி ஷாம்பாலா (ஆன்மீக விழிப்புணர்வு & தியானம்), 2. வாவ் பேரண்டிங் (பெற்றோர் வழிகாட்டல்), 3. நிதி நுண்ணறிவு (பொருளாதார மேலாண்மை), 4. உணர்ச்சி நுண்ணறிவு (உளவியல் சமநிலை), 5. மாஸ்டர் ஸ்ட்ரோக் (தலைமைத்துவ நெறிமுறைகள்), 6. இளம் விஞ்ஞானி (செய்முறை அறிவியல்), மற்றும் 7. ஐராவத் (ஆசிரியரின் 21 பரிணாம நிலைகள்)."}},{"@type":"Question","name":"திவ்ய யோகம் என்றால் என்ன? சந்தோஷி ஸ்ரீ அரவிந்தன் ஜி யார்?","acceptedAnswer":{"@type":"Answer","text":"ஆன்மீக தளத்தில் இவர் சந்தோஷி ஸ்ரீ அரவிந்தன் ஜி என்று அழைக்கப்படுகிறார். 2000-ஆம் ஆண்டு தொடங்கப்பட்ட திவ்ய யோகம், \"மனிதனை மேம்படுத்து. ஆன்மாவை விழிப்படையச் செய்\" என்ற தத்துவத்தின் அடிப்படையில் இயங்கும் ஆன்மீகப் பாதை. இதில் 7 படிநிலை உள்முகப் பயணம், ஒருமை தியானம் மற்றும் 2012 முதல் ஆண்டுதோறும் புதுச்சேரியில் நடைபெறும் மகா ஷாம்பாலா ஆன்மீக சங்கமம் ஆகியவை முக்கியத்துவம் வாய்ந்தவை."}},{"@type":"Question","name":"முனைவர் அரவிந்தன் ஜி பெற்றுள்ள முக்கிய விருதுகள் மற்றும் அங்கீகாரங்கள் யாவை?","acceptedAnswer":{"@type":"Answer","text":"நியூஸ் 7 தமிழின் ஆற்றல் மிகு ஆசிரியர் விருதுகள் 2026-ல் முழுமையான கல்விக்கான விருது, தி டைம்ஸ் ஆஃப் இந்தியாவின் எடு ஐகான் விருது, டைம்ஸ் இன்டராக்ட் டிரெண்ட்செட்டர் விருது, ஜே.சி.ஐ இந்தியாவின் சிறந்த இளைஞர் விருது, மற்றும் இன்பினிட் தாட்ஸ் இதழின் தசாப்தத்தின் சிறந்த முன்னாள் மாணவர் விருது ஆகியவை குறிப்பிடத்தக்கவை."}}]}]}5:["$","div",null,{"className":"section-py","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$18"}}],"$L19"]}]
