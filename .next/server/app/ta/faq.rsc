1d:["$","div","FAQ-04",{"className":"card-premium","style":{"padding":"2rem"},"children":[["$","div",null,{"style":{"display":"flex","justifyContent":"space-between","alignItems":"center","marginBottom":"0.75rem"},"children":[["$","span",null,{"style":{"fontSize":"0.78rem","color":"var(--gold-glow)","fontWeight":800,"textTransform":"uppercase"},"children":"Pedagogy & Neuroscience"}],["$","span",null,{"style":{"fontSize":"0.78rem","color":"#059669","fontWeight":700},"children":["✓ ","சரிபார்க்கப்பட்ட பதில்"]}]]}],["$","h3",null,{"className":"font-serif heading-gold","style":{"fontSize":"1.35rem","marginBottom":"1rem","lineHeight":1.35,"fontWeight":800},"children":"மூளை செயல்பாடு கட்டமைப்பு (Brain Activity System) என்றால் என்ன? அது உலக சாதனைகளுடன் எவ்வாறு தொடர்புடையது?"}],["$","p",null,{"style":{"color":"var(--text-secondary)","fontSize":"0.98rem","lineHeight":1.8,"marginBottom":"1.25rem"},"children":"மதிப்பெண்களை விட மூளையின் செயல்பாடே முக்கியம் என்ற கோட்பாட்டின்படி, நரம்பியல் திறனை வளர்க்கும் பயிற்சி முறை. சிலம்பம், மல்லக்கம்பம், யோகா, சதுரங்கம் மற்றும் பொன்னகை தியானம் ஆகிய ஐந்து கலைகளை உடற்பயிற்சியாக வழங்கி, மாணவர்களின் இரு மூளை அரைக்கோளங்களையும் தூண்டுகிறது. இதன் மூலம் மாணவர்கள் 222 கின்னஸ் மற்றும் உலக சாதனைகள் உட்பட 600+ உலக சாதனைகளை படைத்துள்ளனர்."}],["$","div",null,{"style":{"borderTop":"1px solid var(--border-light)","paddingTop":"0.85rem"},"children":["$","$L13",null,{"href":"/ta/education/brain-activity-system","style":{"display":"inline-flex","alignItems":"center","gap":"0.4rem","color":"var(--gold-glow)","fontWeight":700,"fontSize":"0.86rem","textDecoration":"none"},"children":[["$","span",null,{"children":"மேலும் விரிவாக அறிய"}],["$","$L12",null,{"ref":"$undefined","icon":"$19:props:children:1:props:children:0:props:children:3:props:children:props:children:1:props:icon","className":"$undefined","size":14}]]}]}]]}]
1e:["$","div","FAQ-05",{"className":"card-premium","style":{"padding":"2rem"},"children":[["$","div",null,{"style":{"display":"flex","justifyContent":"space-between","alignItems":"center","marginBottom":"0.75rem"},"children":[["$","span",null,{"style":{"fontSize":"0.78rem","color":"var(--gold-glow)","fontWeight":800,"textTransform":"uppercase"},"children":"Assessment & AI"}],["$","span",null,{"style":{"fontSize":"0.78rem","color":"#059669","fontWeight":700},"children":["✓ ","சரிபார்க்கப்பட்ட பதில்"]}]]}],["$","h3",null,{"className":"font-serif heading-gold","style":{"fontSize":"1.35rem","marginBottom":"1rem","lineHeight":1.35,"fontWeight":800},"children":"ட்ராக் (TRACK) தேர்வு மாதிரி என்றால் என்ன?"}],["$","p",null,{"style":{"color":"var(--text-secondary)","fontSize":"0.98rem","lineHeight":1.8,"marginBottom":"1.25rem"},"children":"தேர்வு பயத்தை முற்றிலும் நீக்கும் மதிப்பீட்டு முறை. இதில் செய்முறை 100% மற்றும் எழுத்துமுறை 100% சமமாக மதிப்பிடப்படுகிறது. தேர்வுக்கு முன்பே பெற்றோருக்கு குழந்தையின் கற்றல் நிலை வெளிப்படையாகத் தெரிகிறது. AI தொழில்நுட்பம் கற்றல் இடைவெளிகளை துல்லியமாக கண்டறிந்து, கூடுதல் பயிற்சிகள் மூலம் அதை நிறைவு செய்கிறது."}],["$","div",null,{"style":{"borderTop":"1px solid var(--border-light)","paddingTop":"0.85rem"},"children":["$","$L13",null,{"href":"/ta/education/track-assessment-model","style":{"display":"inline-flex","alignItems":"center","gap":"0.4rem","color":"var(--gold-glow)","fontWeight":700,"fontSize":"0.86rem","textDecoration":"none"},"children":[["$","span",null,{"children":"மேலும் விரிவாக அறிய"}],["$","$L12",null,{"ref":"$undefined","icon":"$19:props:children:1:props:children:0:props:children:3:props:children:props:children:1:props:icon","className":"$undefined","size":14}]]}]}]]}]
1f:["$","div","FAQ-06",{"className":"card-premium","style":{"padding":"2rem"},"children":[["$","div",null,{"style":{"display":"flex","justifyContent":"space-between","alignItems":"center","marginBottom":"0.75rem"},"children":[["$","span",null,{"style":{"fontSize":"0.78rem","color":"var(--gold-glow)","fontWeight":800,"textTransform":"uppercase"},"children":"Books & Publications"}],["$","span",null,{"style":{"fontSize":"0.78rem","color":"#059669","fontWeight":700},"children":["✓ ","சரிபார்க்கப்பட்ட பதில்"]}]]}],["$","h3",null,{"className":"font-serif heading-gold","style":{"fontSize":"1.35rem","marginBottom":"1rem","lineHeight":1.35,"fontWeight":800},"children":"முனைவர் ஜே. அரவிந்தன் ஜி எழுதிய நூல்கள் யாவை?"}],["$","p",null,{"style":{"color":"var(--text-secondary)","fontSize":"0.98rem","lineHeight":1.8,"marginBottom":"1.25rem"},"children":"முனைவர் அரவிந்தன் ஜி ஏழு முக்கிய நூல்களை எழுதியுள்ளார்: 1. தி ஷாம்பாலா (ஆன்மீக விழிப்புணர்வு & தியானம்), 2. வாவ் பேரண்டிங் (பெற்றோர் வழிகாட்டல்), 3. நிதி நுண்ணறிவு (பொருளாதார மேலாண்மை), 4. உணர்ச்சி நுண்ணறிவு (உளவியல் சமநிலை), 5. மாஸ்டர் ஸ்ட்ரோக் (தலைமைத்துவ நெறிமுறைகள்), 6. இளம் விஞ்ஞானி (செய்முறை அறிவியல்), மற்றும் 7. ஐராவத் (ஆசிரியரின் 21 பரிணாம நிலைகள்)."}],["$","div",null,{"style":{"borderTop":"1px solid var(--border-light)","paddingTop":"0.85rem"},"children":["$","$L13",null,{"href":"/ta/books","style":{"display":"inline-flex","alignItems":"center","gap":"0.4rem","color":"var(--gold-glow)","fontWeight":700,"fontSize":"0.86rem","textDecoration":"none"},"children":[["$","span",null,{"children":"மேலும் விரிவாக அறிய"}],["$","$L12",null,{"ref":"$undefined","icon":"$19:props:children:1:props:children:0:props:children:3:props:children:props:children:1:props:icon","className":"$undefined","size":14}]]}]}]]}]
20:["$","div","FAQ-07",{"className":"card-premium","style":{"padding":"2rem"},"children":[["$","div",null,{"style":{"display":"flex","justifyContent":"space-between","alignItems":"center","marginBottom":"0.75rem"},"children":[["$","span",null,{"style":{"fontSize":"0.78rem","color":"var(--gold-glow)","fontWeight":800,"textTransform":"uppercase"},"children":"Spiritual & Inner Journey"}],["$","span",null,{"style":{"fontSize":"0.78rem","color":"#059669","fontWeight":700},"children":["✓ ","சரிபார்க்கப்பட்ட பதில்"]}]]}],["$","h3",null,{"className":"font-serif heading-gold","style":{"fontSize":"1.35rem","marginBottom":"1rem","lineHeight":1.35,"fontWeight":800},"children":"திவ்ய யோகம் என்றால் என்ன? சந்தோஷி ஸ்ரீ அரவிந்தன் ஜி யார்?"}],["$","p",null,{"style":{"color":"var(--text-secondary)","fontSize":"0.98rem","lineHeight":1.8,"marginBottom":"1.25rem"},"children":"ஆன்மீக தளத்தில் இவர் சந்தோஷி ஸ்ரீ அரவிந்தன் ஜி என்று அழைக்கப்படுகிறார். 2000-ஆம் ஆண்டு தொடங்கப்பட்ட திவ்ய யோகம், \"மனிதனை மேம்படுத்து. ஆன்மாவை விழிப்படையச் செய்\" என்ற தத்துவத்தின் அடிப்படையில் இயங்கும் ஆன்மீகப் பாதை. இதில் 7 படிநிலை உள்முகப் பயணம், ஒருமை தியானம் மற்றும் 2012 முதல் ஆண்டுதோறும் புதுச்சேரியில் நடைபெறும் மகா ஷாம்பாலா ஆன்மீக சங்கமம் ஆகியவை முக்கியத்துவம் வாய்ந்தவை."}],["$","div",null,{"style":{"borderTop":"1px solid var(--border-light)","paddingTop":"0.85rem"},"children":["$","$L13",null,{"href":"/ta/inner-journey","style":{"display":"inline-flex","alignItems":"center","gap":"0.4rem","color":"var(--gold-glow)","fontWeight":700,"fontSize":"0.86rem","textDecoration":"none"},"children":[["$","span",null,{"children":"மேலும் விரிவாக அறிய"}],["$","$L12",null,{"ref":"$undefined","icon":"$19:props:children:1:props:children:0:props:children:3:props:children:props:children:1:props:icon","className":"$undefined","size":14}]]}]}]]}]
21:["$","div","FAQ-08",{"className":"card-premium","style":{"padding":"2rem"},"children":[["$","div",null,{"style":{"display":"flex","justifyContent":"space-between","alignItems":"center","marginBottom":"0.75rem"},"children":[["$","span",null,{"style":{"fontSize":"0.78rem","color":"var(--gold-glow)","fontWeight":800,"textTransform":"uppercase"},"children":"Honours & Awards"}],["$","span",null,{"style":{"fontSize":"0.78rem","color":"#059669","fontWeight":700},"children":["✓ ","சரிபார்க்கப்பட்ட பதில்"]}]]}],["$","h3",null,{"className":"font-serif heading-gold","style":{"fontSize":"1.35rem","marginBottom":"1rem","lineHeight":1.35,"fontWeight":800},"children":"முனைவர் அரவிந்தன் ஜி பெற்றுள்ள முக்கிய விருதுகள் மற்றும் அங்கீகாரங்கள் யாவை?"}],["$","p",null,{"style":{"color":"var(--text-secondary)","fontSize":"0.98rem","lineHeight":1.8,"marginBottom":"1.25rem"},"children":"நியூஸ் 7 தமிழின் ஆற்றல் மிகு ஆசிரியர் விருதுகள் 2026-ல் முழுமையான கல்விக்கான விருது, தி டைம்ஸ் ஆஃப் இந்தியாவின் எடு ஐகான் விருது, டைம்ஸ் இன்டராக்ட் டிரெண்ட்செட்டர் விருது, ஜே.சி.ஐ இந்தியாவின் சிறந்த இளைஞர் விருது, மற்றும் இன்பினிட் தாட்ஸ் இதழின் தசாப்தத்தின் சிறந்த முன்னாள் மாணவர் விருது ஆகியவை குறிப்பிடத்தக்கவை."}],["$","div",null,{"style":{"borderTop":"1px solid var(--border-light)","paddingTop":"0.85rem"},"children":["$","$L13",null,{"href":"/ta/recognition","style":{"display":"inline-flex","alignItems":"center","gap":"0.4rem","color":"var(--gold-glow)","fontWeight":700,"fontSize":"0.86rem","textDecoration":"none"},"children":[["$","span",null,{"children":"மேலும் விரிவாக அறிய"}],["$","$L12",null,{"ref":"$undefined","icon":"$19:props:children:1:props:children:0:props:children:3:props:children:props:children:1:props:icon","className":"$undefined","size":14}]]}]}]]}]
