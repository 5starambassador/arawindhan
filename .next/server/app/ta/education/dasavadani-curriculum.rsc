ுக நுண்ணறிவுப் பாடத்திட்டம். ஹோவர்ட் கார்ட்னரின் 8 நுண்ணறிவுகளுடன், முனைவர் அரவிந்தன் அவர்கள் வடிவமைத்த நிதி நுண்ணறிவு (FI) மற்றும் உணர்ச்சி நுண்ணறிவு (EI) ஆகியவற்றை இணைத்து, குவாண்டம் நுண்ணறிவு மூலம் குழந்தைகளை \"சுப்ராசேபியன்ஸ்\" (Suprasapiens) ஆக உருவாக்குகிறது."}]]}],["$","div",null,{"className":"card-premium","children":[["$","h3",null,{"className":"font-serif heading-white","style":{"fontSize":"1.25rem","marginBottom":"0.75rem","fontWeight":800},"children":"2. வடிவமைப்பாளர் & தலைமை (Origin & Leadership)"}],["$","p",null,{"style":{"color":"var(--text-secondary)","fontSize":"0.95rem","lineHeight":1.75},"children":"முனைவர் ஜே. அரவிந்தன் ஜி அவர்களால் 2000-ஆம் ஆண்டு முதல் தனிப்பட்ட முறையில் வடிவமைக்கப்பட்டு, ஆச்சாரியா சிறப்பு மேன்மை மையம் (Centre of Excellence) மற்றும் ஆசிரியப் பயிற்சி அகாடமிகள் மூலம் செறிவூட்டப்பட்டது."}]]}],["$","div",null,{"className":"card-premium","children":[["$","h3",null,{"className":"font-serif heading-white","style":{"fontSize":"1.25rem","marginBottom":"0.75rem","fontWeight":800},"children":"3 & 4. செயல்பாட்டு முறை & அடிப்படைக் கொள்கைகள்"}],["$","ul",null,{"style":{"paddingLeft":"1.25rem","display":"flex","flexDirection":"column","gap":"0.75rem","color":"var(--text-secondary)","fontSize":"0.95rem","lineHeight":1.7},"children":[["$","li","0",{"children":"அவதானக் கலையை அடிப்படையாகக் கொண்டது: பஞ்சாவதானி (5 பணிகள்), அஷ்டாவதானி (8 பணிகள்) முதல் தசாவதானி (10 பணிகள்) வரை படிநிலை வளர்ச்சி."}],["$","li","1",{"children":"10,000 மணிநேர பயிற்சி தத்துவத்தில் கட்டமைக்கப்பட்டது: \"அவதானி முதல் தசாவதானி வரை\"."}],["$","li","2",{"children":"சிபிஎஸ்இ, ஐசிஎஸ்இ மற்றும் மாநிலப் பாடத்திட்டங்களுடன் நடைமுறை வாழ்வியல் பயிற்சிகளை இணைக்கிறது."}],["$","li","3",{"children":"கல்வி, தலைமைத்துவம், படைப்பாற்றல், உடல்-மூளை நரம்பியல் வளர்ச்சி மற்றும் நற்பண்புகளை ஒருங்கிணைக்கிறது."}],["$","li","4",{"children":"நோக்கம்: ஒவ்வொரு குழந்தையையும் தங்களின் தனித்துவமான \"நுண்ணறிவு சாம்ராஜ்யத்தில்\" கோலோச்சச் செய்தல்."}]]}]]}],["$","div",null,{"className":"card-premium","children":[["$","h3",null,{"className":"font-serif heading-white","style":{"fontSize":"1.25rem","marginBottom":"0.75rem","fontWeight":800},"children":"5. செயல்படுத்தப்படும் களங்கள் (Implementation Settings)"}],["$","p",null,{"style":{"color":"var(--text-secondary)","fontSize":"0.95rem","lineHeight":1.75},"children":"ஆச்சாரியாவின் சொந்த வளாகங்கள் (71 வளாகங்கள்), கூட்டாண்மைப் பள்ளிகள் மற்றும் ஹெகுரு மையங்களில் மழலையர் பருவம் முதல் 12-ஆம் வகுப்பு வரையிலான மாணவர்களுக்கு தினசரி கால அட்டவணையில் முறையாக இணைக்கப்பட்டுள்ளது."}]]}],"$L19","$L1a"]}]]}]}]
