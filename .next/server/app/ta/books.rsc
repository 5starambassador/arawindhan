:"var(--text-secondary)","fontSize":"0.9rem","lineHeight":1.7,"marginBottom":"1.25rem"},"children":"ஆச்சாரியாவின் 73+ செய்முறை ஆய்வகங்கள் மற்றும் அடல் டிங்கரிங் லேப்களின் பின்னணியில் உருவான நூல். ஏட்டுச் சுரைக்காயாக அறிவியலை படிக்காமல், குழந்தைகள் கைகளால் செய்து பார்த்து, சோதனைகள் மூலம் உண்மைகளைக் கண்டறியும் வழிமுறையை விளக்குகிறது."}],["$","div",null,{"style":{"display":"flex","flexWrap":"wrap","gap":"0.35rem","marginBottom":"1.5rem"},"children":[["$","span","0",{"style":{"background":"#F1F5F9","border":"1px solid #E2E8F0","color":"var(--text-secondary)","fontSize":"0.74rem","fontWeight":500,"padding":"0.15rem 0.5rem","borderRadius":"var(--radius-full)"},"children":"ஏட்டுப் படிப்பை நேரடி அறிவியல் பரிசோதனைகளாக மாற்றுதல்"}],["$","span","1",{"style":{"background":"#F1F5F9","border":"1px solid #E2E8F0","color":"var(--text-secondary)","fontSize":"0.74rem","fontWeight":500,"padding":"0.15rem 0.5rem","borderRadius":"var(--radius-full)"},"children":"அடல் டிங்கரிங் மனநிலை: யோசி, மாதிரி செய், சோதித்து மேம்படுத்து"}]]}]]}],["$","div",null,{"style":{"borderTop":"1px solid var(--border-light)","paddingTop":"1rem","textAlign":"right"},"children":["$","$L13",null,{"href":"/ta/books/young-scientist","className":"btn-gold","style":{"width":"100%","justifyContent":"center","fontSize":"0.85rem","padding":"0.55rem 1rem"},"children":[["$","span",null,{"children":"நூல் விவரங்கள் & சாரம்"}],["$","$L12",null,{"ref":"$undefined","icon":"$19:props:children:props:children:1:props:icon","className":"$undefined","size":14}]]}]}]]}]
1f:["$","div","BK-007",{"className":"card-premium","style":{"display":"flex","flexDirection":"column","justifyContent":"space-between"},"children":[["$","div",null,{"children":[["$","div",null,{"style":{"display":"flex","justifyContent":"space-between","alignItems":"center","marginBottom":"0.85rem"},"children":[["$","span",null,{"style":{"background":"#FFFBEB","border":"1px solid #FDE68A","color":"var(--gold-glow)","fontWeight":800,"fontSize":"0.78rem","padding":"0.2rem 0.6rem","borderRadius":"var(--radius-sm)","textTransform":"uppercase"},"children":"Ecosystem Edition"}],["$","$L18",null,{"claimId":"CLM-023","status":"SOURCE_CLAIM","language":"ta"}]]}],["$","div",null,{"style":{"height":"140px","borderRadius":"var(--radius-sm)","background":"linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%)","border":"1px solid #FDE68A","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center","marginBottom":"1.25rem","textAlign":"center","padding":"1rem","boxShadow":"var(--shadow-sm)"},"children":[["$","$L12",null,{"ref":"$undefined","icon":"$5:props:children:props:children:1:props:children:0:props:children:0:props:children:1:props:children:0:props:icon","className":"$undefined","size":32,"color":"var(--gold-primary)","style":{"marginBottom":"0.5rem"}}],["$","div",null,{"className":"font-serif","style":{"fontSize":"1.05rem","fontWeight":800,"color":"#78350F"},"children":"ஐராவத் (Iravadh)"}],["$","div",null,{"style":{"fontSize":"0.75rem","color":"var(--text-muted)","fontWeight":600},"children":"ConCardios Teacher Training Edition"}]]}],["$","h3",null,{"className":"font-serif heading-gold","style":{"fontSize":"1.35rem","marginBottom":"0.35rem","fontWeight":800},"children":"ஐராவத் (Iravadh)"}],["$","p",null,{"style":{"color":"var(--text-muted)","fontSize":"0.86rem","fontStyle":"italic","marginBottom":"1rem"},"children":"ஆசிரியர் பரிணாமத்தின் 21 நிலைகள் மற்றும் குருத்துவத்தின் புனித மாண்பு"}],["$","p",null,{"style":{"color":"var(--text-secondary)","fontSize":"0.9rem","lineHeight":1.7,"marginBottom":"1.25rem"},"children":"நிலைத்த வலிமை மற்றும் ஞானத்தின் அடையாளமான ஐராவதத்தின் பெயரால் அமைந்த இந்நூல், ஆச்சாரியாவின் கான்கார்டியோஸ் ஆசிரியர் பயிற்சிக்கான வழிகாட்டி நூலாகும். சாதாரண பயிற்றுவிப்பாளராக தொடங்கும் ஓர் ஆசிரியர், எவ்வாறு 21 நிலைகளைக் கடந்து, மாணவர்களின் உள்ளார்ந்த மேதமையை விழித்தெழச் செய்யும் ஞான குருவாக மாறுகிறார் என்பதை இந்நூல் விளக்குகிறது."}],["$","div",null,{"style":{"display":"flex","flexWrap":"wrap","gap":"0.35rem","marginBottom":"1.5rem"},"children":[["$","span","0",{"style":{"background":"#F1F5F9","border":"1px solid #E2E8F0","color":"var(--text-secondary)","fontSize":"0.74rem","fontWeight":500,"padding":"0.15rem 0.5rem","borderRadius":"var(--radius-full)"},"children":"ஆசிரியர் விழிப்புணர்வு மற்றும் கற்பித்தல் ஆளுமையின் 21 படிநிலைகள்"}],["$","span","1",{"style":{"background":"#F1F5F9","border":"1px solid #E2E8F0","color":"var(--text-secondary)","fontSize":"0.74rem","fontWeight":500,"padding":"0.15rem 0.5rem","borderRadius":"var(--radius-full)"},"children":"பாடம் நடத்துவதில் இருந்து குழந்தைகளை ஊக்கப்படுத்தி மாற்றியமைக்கும் நிலைக்கு நகர்தல்"}]]}]]}],["$","div",null,{"style":{"borderTop":"1px solid var(--border-light)","paddingTop":"1rem","textAlign":"right"},"children":["$","$L13",null,{"href":"/ta/books/iravadh-book","className":"btn-gold","style":{"width":"100%","justifyContent":"center","fontSize":"0.85rem","padding":"0.55rem 1rem"},"children":[["$","span",null,{"children":"நூல் விவரங்கள் & சாரம்"}],["$","$L12",null,{"ref":"$undefined","icon":"$19:props:children:props:children:1:props:icon","className":"$undefined","size":14}]]}]}]]}]
