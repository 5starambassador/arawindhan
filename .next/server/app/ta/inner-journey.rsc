rem","lineHeight":1.8,"maxWidth":"800px","margin":"0 auto 1.5rem auto"},"children":"2000-ஆம் ஆண்டு கல்விப் பணியோடு இணைந்து தொடங்கியது திவ்ய யோகம். புற உலகில் வெற்றிகளை குவிப்பது மட்டுமே வாழ்க்கையின் இலக்காகிவிட முடியாது என்ற ஆழமான தேடலின் விளைவாக இது உருவானது. ஆயிரக்கணக்கான மாணவர்கள், ஆசிரியர்களோடு பணியாற்றியதில், வெறும் திறமையை விட உள்ளத்து அமைதியும் விழிப்புணர்வே அடிப்படை தேவை என்பது தெளிவாகியது."}],["$","$L18",null,{"claimId":"CLM-028","status":"CONFIRMED","language":"ta"}]]}],["$","div",null,{"style":{"marginBottom":"4rem"},"children":[["$","div",null,{"style":{"textAlign":"center","marginBottom":"3rem","maxWidth":"800px","margin":"0 auto 3rem auto"},"children":[["$","div",null,{"style":{"marginBottom":"0.75rem"},"children":["$","span",null,{"style":{"display":"inline-block","background":"rgba(212, 175, 55, 0.1)","border":"1px solid rgba(212, 175, 55, 0.35)","color":"var(--gold-glow)","padding":"0.25rem 0.85rem","borderRadius":"9999px","fontSize":"0.8rem","fontWeight":700,"letterSpacing":"0.08em","textTransform":"uppercase"},"children":"உள்முகப் பரிணாமம்"}]}],["$","h2",null,{"className":"font-serif heading-gold","style":{"fontSize":"clamp(1.75rem, 3.5vw, 2.5rem)","fontWeight":700,"lineHeight":1.25,"marginBottom":"1rem"},"children":"ஏழு படிநிலை உள்முகப் பயணம்"}],["$","p",null,{"style":{"color":"var(--text-muted)","fontSize":"1.05rem","lineHeight":1.7},"children":"தன்னை அறிவதிலிருந்து தினமும் விழிப்புணர்வுடன் வாழ்வது வரையிலான படிநிலை மாற்றம்."}]]}],["$","div",null,{"style":{"display":"flex","flexDirection":"column","gap":"1.25rem"},"children":[["$","div","01",{"className":"card-premium","style":{"display":"flex","alignItems":"center","gap":"1.5rem","padding":"1.25rem 2rem"},"children":[["$","div",null,{"style":{"minWidth":"45px","height":"45px","borderRadius":"50%","background":"#FFFBEB","border":"1px solid #FDE68A","display":"flex","alignItems":"center","justifyContent":"center","color":"var(--gold-glow)","fontWeight":800},"children":"01"}],["$","div",null,{"styl