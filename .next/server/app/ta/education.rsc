9:{"metadata":[["$","title","0",{"children":"முனைவர் ஜே. அரவிந்தன் ஜி — அதிகாரப்பூர்வ டிஜிட்டல் அறிவுத் தளம்"}],["$","meta","1",{"name":"description","content":"ஆச்சாரியா கல்வி நிறுவனங்களின் நிறுவனர், கல்வியியலாளர், மற்றும் 18 கல்லூரிகள், 101 பள்ளிகள், 61+ நிறுவனங்களின் தலைவர் முனைவர் ஜே. அரவிந்தன் ஜி அவர்களின் அதிகாரப்பூர்வ தளம்."}],["$","link","2",{"rel":"canonical","href":"https://arawindhan.org/ta"}],["$","link","3",{"rel":"alternate","hrefLang":"en","href":"https://arawindhan.org/en"}],["$","link","4",{"rel":"alternate","hrefLang":"ta","href":"https://arawindhan.org/ta"}],["$","link","5",{"rel":"alternate","hrefLang":"x-default","href":"https://arawindhan.org/en"}]],"error":null,"digest":"$undefined"}
