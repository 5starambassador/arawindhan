e":"0.9rem","fontWeight":600,"marginBottom":"0.75rem"},"children":"பத்து நுண்ணறிவுகள், ஓர் ஒருங்கிணைந்த கல்விமுறை"}],["$","p",null,{"style":{"color":"var(--gold-glow)","fontSize":"0.88rem","fontStyle":"italic","marginBottom":"1.25rem"},"children":["“","பன்முகத் திறன்களை ஒரே நேரத்தில் வளர்க்கும் செவ்வியல் அவதானக் கலையின் நவீன வடிவம்.","”"]}],["$","p",null,{"style":{"color":"var(--text-secondary)","fontSize":"0.92rem","lineHeight":1.75,"marginBottom":"1.5rem"},"children":"ஆச்சாரியாவின் தனியுரிமை பெற்ற பன்முக நுண்ணறிவுப் பாடத்திட்டம். ஹோவர்ட் கார்ட்னரின் 8 நுண்ணறிவுகளுடன், முனைவர் அரவிந்தன் அவர்கள் வடிவமைத்த நிதி நுண்ணறிவு (FI) மற்றும் உணர்ச்சி நுண்ணறிவு (EI) ஆகியவற்றை இணைத்து, குவாண்டம் நுண்ணறிவு மூலம் குழந்தைகளை \"சுப்ராசேபியன்ஸ்\" (Suprasapiens) ஆக உருவாக்குகிறது."}],["$","div",null,{"style":{"marginBottom":"1.5rem"},"children":[["$","div",null,{"style":{"color":"var(--gold-glow)","fontSize":"0.82rem","fontWeight":800,"textTransform":"uppercase","marginBottom":"0.5rem"},"children":"முக்கிய செயல்பாடுகள்:"}],["$","ul",null,{"style":{"paddingLeft":"1.2rem","color":"var(--text-secondary)","fontSize":"0.86rem","display":"flex","flexDirection":"column","gap":"0.35rem"},"children":[["$","li","0",{"children":"அவதானக் கலையை அடிப்படையாகக் கொண்டது: பஞ்சாவதானி (5 பணிகள்), அஷ்டாவதானி (8 பணிகள்) முதல் தசாவதானி (10 பணிகள்) வரை படிநிலை வளர்ச்சி."}],["$","li","1",{"children":"10,000 மணிநேர பயிற்சி தத்துவத்தில் கட்டமைக்கப்பட்டது: \"அவதானி முதல் தசாவதானி வரை\"."}],["$","li","2",{"children":"சிபிஎஸ்இ, ஐசிஎஸ்இ மற்றும் மாநிலப் பாடத்திட்டங்களுடன் நடைமுறை வாழ்வியல் பயிற்சிகளை இணைக்கிறது."}]]}]]}]]}],["$","div",null,{"style":{"borderTop":"1px solid var(--border-light)","paddingTop":"1rem","display":"flex","justifyContent":"space-between","alignItems":"center"},"children":[["$","span",null,{"style":{"fontSize":"0.78rem","color":"#047857","fontWeight":700},"children":["★ ","அனைத்து ஆச்சாரியா பள்ளிகள், WOW திட்டங்கள் மற்றும் ஹெகுரு மையங்களில் நடைமுறையில் உள்ளது."]}],["$","$L13",null,{"href":"/