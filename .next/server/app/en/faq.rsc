1d:["$","div","FAQ-04",{"className":"card-premium","style":{"padding":"2rem"},"children":[["$","div",null,{"style":{"display":"flex","justifyContent":"space-between","alignItems":"center","marginBottom":"0.75rem"},"children":[["$","span",null,{"style":{"fontSize":"0.78rem","color":"var(--gold-glow)","fontWeight":800,"textTransform":"uppercase"},"children":"Pedagogy & Neuroscience"}],["$","span",null,{"style":{"fontSize":"0.78rem","color":"#059669","fontWeight":700},"children":["✓ ","Verified Fact"]}]]}],["$","h3",null,{"className":"font-serif heading-gold","style":{"fontSize":"1.35rem","marginBottom":"1rem","lineHeight":1.35,"fontWeight":800},"children":"What is the Brain Activity System and how does it relate to student world records?"}],["$","p",null,{"style":{"color":"var(--text-secondary)","fontSize":"0.98rem","lineHeight":1.8,"marginBottom":"1.25rem"},"children":"The Brain Activity System operates on the philosophy of \"Brain Activity over Ability,\" asserting that working memory, bilateral coordination, and courage can be trained like a physical muscle. It integrates the Five Arts (Silambam, Malkhamb, Yoga, Chess, Golden Smile Meditation) and bilateral ball juggling into the daily timetable. This systematic neuro-training has enabled ACHARIYA students to achieve 600+ world records, including 222 Guinness and World Records in open and blindfolded activities."}],["$","div",null,{"style":{"borderTop":"1px solid var(--border-light)","paddingTop":"0.85rem"},"children":["$","$L13",null,{"href":"/en/education/brain-activity-system","style":{"display":"inline-flex","alignItems":"center","gap":"0.4rem","color":"var(--gold-glow)","fontWeight":700,"fontSize":"0.86rem","textDecoration":"none"},"children":[["$","span",null,{"children":"Explore Detailed Topic Page"}],["$","$L12",null,{"ref":"$undefined","icon":"$1a:props:children:1:props:children:0:props:children:3:props:children:props:children:1:props:icon","className":"$undefined","size":14}]]}]}]]}]
