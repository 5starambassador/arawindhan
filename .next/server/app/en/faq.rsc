n":[["$","div",null,{"style":{"display":"grid","gridTemplateColumns":"repeat(auto-fit, minmax(240px, 1fr))","gap":"2.5rem","marginBottom":"3.5rem"},"children":[["$","div",null,{"children":[["$","div",null,{"className":"font-serif heading-gold","style":{"fontSize":"1.35rem","fontWeight":800,"marginBottom":"0.75rem"},"children":"Dr. J. Arawindhan Ji"}],["$","p",null,{"style":{"color":"var(--text-muted)","fontSize":"0.92rem","lineHeight":1.7,"marginBottom":"1.25rem"},"children":"This official digital knowledge platform documents the educational systems, enterprises, publications, and philosophies founded and led by Dr. J. Arawindhan Ji. Every factual statement is cross-referenced with institutional primary documents."}],["$","div",null,{"style":{"display":"inline-flex","alignItems":"center","gap":"0.5rem","background":"#ECFDF5","border":"1px solid #A7F3D0","padding":"0.35rem 0.75rem","borderRadius":"var(--radius-sm)"},"children":[["$","$L12",null,{"ref":"$undefined","icon":{"name":"shield-check","size":24,"node":[["path",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z","key":"oel41y"}],["path",{"d":"m9 12 2 2 4-4","key":"dzmm74"}]]},"className":"$undefined","size":16,"color":"#059669"}],["$","span",null,{"style":{"fontSize":"0.8rem","color":"#065F46","fontWeight":700},"children":"Factual Integrity Architecture Active"}]]}]]}],["$","div",null,{"children":[["$","div",null,{"style":{"color":"var(--gold-glow)","fontSize":"0.92rem","fontWeight":800,"textTransform":"uppercase","letterSpacing":"0.06em","marginBottom":"1rem"},"children":"Quick Links"}],["$","ul",null,{"style":{"listStyle":"none","display":"flex","flexDirection":"column","gap":"0.65rem"},"children":[["$","li",null,{"children":["$","$L13",null,{"href":"/en/biography","style":{"color":"var(--text-secondary)","textDecoration":"none","fontSize":"0.9rem","fontWeight":500},"children":"Biography & 1